# bsptile-mac: skhd keybindings
# Ported from github.com/z-con/bsptile. GNOME used Super (Windows key) for
# everything; macOS overloads Cmd far more heavily than GNOME overloads
# Super, so this port uses cmd+alt as the base modifier instead. See
# README.md for the full mapping and rationale.

# --- tiling: pull/release the focused window -------------------------------
# bsptile: Super+T / Super+Shift+T
cmd + alt - t         : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/tile-focused.sh
cmd + alt + shift - t : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/untile-focused.sh

# --- resize the shared divider ---------------------------------------------
# bsptile: Ctrl+Super+Arrow keys
ctrl + cmd + alt - left  : yabai -m window --resize left:-20:0   || yabai -m window --resize right:-20:0
ctrl + cmd + alt - right : yabai -m window --resize right:20:0   || yabai -m window --resize left:20:0
ctrl + cmd + alt - up    : yabai -m window --resize top:0:-20    || yabai -m window --resize bottom:0:-20
ctrl + cmd + alt - down  : yabai -m window --resize bottom:0:20  || yabai -m window --resize top:0:20

# --- directional focus movement --------------------------------------------
# Not part of bsptile's own keymap (Alt-Tab covered this on GNOME) -- added
# here because macOS's Cmd+Tab is app-based, not window-based, so it doesn't
# give you directional movement through a bsp tree the way Alt-Tab did.
cmd + alt - h : yabai -m window --focus west
cmd + alt - j : yabai -m window --focus south
cmd + alt - k : yabai -m window --focus north
cmd + alt - l : yabai -m window --focus east

# --- close focused window ---------------------------------------------------
# bsptile: Super+W
cmd + alt - w : yabai -m window --close

# --- per-monitor virtual workspaces ------------------------------------------
# bsptile: Super+1..9,0 / Super+Shift+1..9,0. On macOS this rides yabai's
# native per-display Spaces (System Settings > Desktop & Dock > "Displays
# have separate Spaces" must be ON, which is the macOS default) instead of
# bsptile's simulated minimize/unminimize approach. See bin/space-focus.sh.
cmd + alt - 1 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-focus.sh 1
cmd + alt - 2 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-focus.sh 2
cmd + alt - 3 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-focus.sh 3
cmd + alt - 4 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-focus.sh 4
cmd + alt - 5 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-focus.sh 5
cmd + alt - 6 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-focus.sh 6
cmd + alt - 7 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-focus.sh 7
cmd + alt - 8 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-focus.sh 8
cmd + alt - 9 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-focus.sh 9
cmd + alt - 0 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-focus.sh 0

cmd + alt + shift - 1 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-move.sh 1
cmd + alt + shift - 2 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-move.sh 2
cmd + alt + shift - 3 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-move.sh 3
cmd + alt + shift - 4 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-move.sh 4
cmd + alt + shift - 5 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-move.sh 5
cmd + alt + shift - 6 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-move.sh 6
cmd + alt + shift - 7 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-move.sh 7
cmd + alt + shift - 8 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-move.sh 8
cmd + alt + shift - 9 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-move.sh 9
cmd + alt + shift - 0 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-move.sh 0

# --- direct workspace jump, no creation ------------------------------------
# bare Cmd+1..9,0 -- NOT cmd+alt like the slot bindings above, by request.
# Note this globally overrides whatever Cmd+1..9 already does inside
# individual apps (browser tab switching, Finder view modes, etc.) --
# exactly the kind of collision cmd+alt was chosen everywhere else in this
# file to avoid (see the top of this file). Jumps straight to slot N on the
# currently focused display if it exists; if N is beyond however many
# slots currently exist, lands on the last one (the spare) instead of
# creating empty slots up to N -- see bin/space-goto.sh.
cmd - 1 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-goto.sh 1
cmd - 2 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-goto.sh 2
cmd - 3 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-goto.sh 3
cmd - 4 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-goto.sh 4
cmd - 5 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-goto.sh 5
cmd - 6 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-goto.sh 6
cmd - 7 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-goto.sh 7
cmd - 8 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-goto.sh 8
cmd - 9 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-goto.sh 9
cmd - 0 : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/space-goto.sh 0

# --- terminal / app launch ---------------------------------------------------
# bsptile: Super+Return / Shift+Super+Return / Ctrl+Super+Return
cmd - return               : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/new-ghostty-window.sh
cmd + alt - return         : "$(dirname "$(readlink "$HOME/.skhdrc")")/bin"/new-ghostty-window.sh
cmd + alt + shift - return : open -na Firefox --args --new-window
ctrl + cmd + alt - return  : open -na Ghostty --args -e "sh -c 'cd ~/Claude && claude'"

# Note: no remap for Activities/Overview -- macOS already has Cmd+Space
# (Spotlight) as the equivalent, no need to take over another binding for it.
